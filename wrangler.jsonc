{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swipe-republic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "swiperepublic.deadpackets.pw", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "CAMPAIGNS",
      "database_name": "swipe-republic-campaigns",
      "database_id": "880f4212-2095-4dd6-b130-fef706bf3236",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ART", "bucket_name": "swipe-republic-art" }],
  "durable_objects": {
    "bindings": [
      { "name": "DYNASTIES", "class_name": "Dynasty" },
      { "name": "LEDGER", "class_name": "Ledger" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Society", "Budget"] },
    {
      "tag": "v2-reset-2026-09-22",
      "new_sqlite_classes": ["SocietyV2"],
    },
    { "tag": "v3-delete-old-societies", "deleted_classes": ["Society"] },
    { "tag": "v4-purge-2-create", "new_sqlite_classes": ["SocietyV3"] },
    { "tag": "v5-purge-2-delete", "deleted_classes": ["SocietyV2"] },
    { "tag": "v6-dynasty-create", "new_sqlite_classes": ["Dynasty", "Ledger"] },
    { "tag": "v7-dynasty-delete", "deleted_classes": ["SocietyV3", "Budget"] },
  ],
  "vars": { "DAILY_AI_BUDGET": "1.00", "GAME_AI_BUDGET": "0.20" },
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "52954",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
